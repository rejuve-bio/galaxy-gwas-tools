<tool id="gwaslab_load_sumstats" name="GWASLab Load Sumstats" version="0.1.0" profile="24.0">
    <description>Load GWAS summary statistics into a standardized GWASLab table</description>
    <requirements>
        <requirement type="package" version="4.0.4">gwaslab</requirement>
        <requirement type="package" version="3.12">python</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
#if str($mode_selector.load_mode) == "chromsplit"
cat /dev/null > chrom_manifest.tsv
#for $element in $mode_selector.chrom_files
echo '${element.element_identifier}\t${element}' >> chrom_manifest.tsv
#end for
#end if
python '$__tool_directory__/run_load_sumstats.py'
--mode '$mode_selector.load_mode'
#if str($mode_selector.load_mode) == "columns"
--input '$mode_selector.input'
--sep '$shared.sep'
--skiprows '$shared.skiprows'
#if str($shared.nrows)
--nrows '$shared.nrows'
#end if
#if str($shared.na_values)
--na-values '$shared.na_values'
#end if
#if str($shared.build) != "unset"
--build '$shared.build'
#end if
#if $shared.verbose
--verbose
#end if
#for $flag, $value in [
    ("snpid", $mode_selector.snpid),
