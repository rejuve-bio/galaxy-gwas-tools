<tool id="gwaslab_qc_check" name="GWASLab QC Check" version="0.1.0" profile="24.0">
    <description>Run GWASLab QC checks and generate a JSON QC report</description>
    <requirements>
        <requirement type="package" version="4.0.4">gwaslab</requirement>
        <requirement type="package" version="3.12">python</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/run_qc_check.py'
--input '$input'
--input-format '$input_format'
#if str($build) != "unset"
--build '$build'
#end if
#if $remove_dup
--remove-dup
#end if
--threads '$threads'
--output-tsv '$output_tsv'
--output-report '$output_report'
--log '$log'
]]></command>
    <inputs>
        <param name="input" type="data" format="tabular,txt,tsv,csv,gz" label="Input summary statistics table" />
        <param name="input_format" type="select" label="Input format">
            <option value="gwaslab" selected="true">GWASLab standardized table</option>
            <option value="auto">Auto-detect</option>
        </param>
        <param name="build" type="select" label="Genome build hint">
            <option value="unset" selected="true">Leave unset</option>
            <option value="19">hg19 / GRCh37</option>
            <option value="38">hg38 / GRCh38</option>
            <option value="99">Unknown</option>
        </param>
        <param name="remove_dup" type="boolean" truevalue="true" falsevalue="false" checked="true" label="Remove duplicate variants after QC checks" />
        <param name="threads" type="integer" value="1" min="1" label="Threads hint for QC execution" />
    </inputs>
    <outputs>
        <data name="output_tsv" format="tabular" label="${tool.name} on ${on_string}: QC table" />
        <data name="output_report" format="json" label="${tool.name} on ${on_string}: QC report" />
        <data name="log" format="txt" label="${tool.name} on ${on_string}: log" />
    </outputs>
    <tests>
        <!--
        This test checks that the QC tool counts duplicate rows from the shared
        sample-data fixture and removes them when the option is enabled.
        Run it with:
            planemo test tools/qc_check/tool.xml
        -->
        <test expect_num_outputs="3">
            <param name="input" value="../../../gwaslab-sample-data/standardize_case.tsv" />
            <param name="input_format" value="gwaslab" />
            <param name="remove_dup" value="true" />
            <param name="threads" value="1" />
            <output name="output_tsv">
                <assert_contents>
                    <has_text text="SNPID" />
                    <has_text text="rs1" />
                    <has_n_lines n="2" />
                </assert_contents>
            </output>
            <output name="output_report">
                <assert_contents>
                    <has_text text='"mode": "qc_check"' />
                    <has_text text='"duplicate_variant_rows": 1' />
                    <has_text text='"duplicate_rows_removed": 1' />
                    <has_text text='"remove_dup": true' />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
This tool is intended for the QC stage after loading or standardization. It wraps GWASLab's `check_sanity()` and `check_data_consistency()` methods, and can optionally remove duplicate variants with `remove_dup()`.

Outputs:

- A tabular summary-statistics table after the QC stage
- A JSON QC report with counts for missing required values, invalid alleles, and duplicate variants
- The GWASLab execution log

Testing locally:

```bash
planemo test tools/qc_check/tool.xml
```
]]></help>
    <citations>
        <citation type="doi">10.51094/jxiv.370</citation>
    </citations>
</tool>
