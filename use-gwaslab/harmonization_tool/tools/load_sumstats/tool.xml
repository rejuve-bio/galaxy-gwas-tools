    <tests>
        <!--
        This test exercises the manual column-mapping mode.
        Run it with:
            planemo test tools/load_sumstats/tool.xml
        -->
        <test expect_num_outputs="3">
            <conditional name="mode_selector">
                <param name="load_mode" value="columns" />
                <param name="input" value="../../../gwaslab-sample-data/bbj_t2d_hm3_chr7_variants.txt.gz" />
                <param name="snpid" value="SNPID" />
                <param name="chrom" value="CHR" />
                <param name="pos" value="POS" />
                <param name="ea" value="EA" />
                <param name="nea" value="NEA" />
                <param name="eaf" value="EAF" />
                <param name="beta" value="BETA" />
                <param name="se" value="SE" />
                <param name="p" value="P" />
                <param name="n" value="N" />
            </conditional>
            <output name="output_tsv">
                <assert_contents>
                    <has_text text="SNPID" />
                    <has_text text="CHR" />
                    <has_text text="1:752566_G_A" />
                </assert_contents>
            </output>
            <output name="output_meta">
                <assert_contents>
                    <has_text text='"mode": "columns"' />
                </assert_contents>
            </output>
        </test>

        <!--
        This test checks the format-keyword mode using a GWASLab-shaped input table.
        It keeps the assertions intentionally small so the test remains stable even if
        GWASLab changes non-essential metadata fields in future releases.
        -->
        <test expect_num_outputs="3">
            <conditional name="mode_selector">
                <param name="load_mode" value="format" />
                <param name="input" value="../../../gwaslab-sample-data/bbj_t2d_hm3_chr7_variants.txt.gz" />
                <param name="format_name" value="gwaslab" />
            </conditional>
            <output name="output_tsv">
                <assert_contents>
                    <has_text text="EA" />
                    <has_text text="NEA" />
                    <has_text text="rs3094315" />
                </assert_contents>
            </output>
            <output name="output_meta">
                <assert_contents>
                    <has_text text='"mode": "format"' />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
This tool wraps `gl.Sumstats()` and exposes the four GWASLab loading modes documented in the Sumstats Object guide:

- Load by specifying columns
- Load by specifying formats
- Load sumstats with auto mode
- Load sumstats from chromosome-separated files

The main output is a normalized tabular dataset generated from `mysumstats.data`, plus JSON metadata and the GWASLab log.

For chromosome-separated files, provide a Galaxy dataset collection where each element identifier is the chromosome label.

Testing locally:

```bash
planemo test tools/load_sumstats/tool.xml
```
]]></help>
