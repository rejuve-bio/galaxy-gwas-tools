    ("mlog10p", $mode_selector.mlog10p),
    ("info", $mode_selector.info),
    ("direction", $mode_selector.direction),
    ("ncontrol", $mode_selector.ncontrol),
    ("ncase", $mode_selector.ncase),
    ("maf", $mode_selector.maf),
    ("status", $mode_selector.status),
    ("or-column", $mode_selector.or_column),
    ("or-95l", $mode_selector.or_95l),
    ("or-95u", $mode_selector.or_95u),
    ("hr-column", $mode_selector.hr_column),
    ("hr-95l", $mode_selector.hr_95l),
    ("hr-95u", $mode_selector.hr_95u),
    ("beta-95l", $mode_selector.beta_95l),
    ("beta-95u", $mode_selector.beta_95u),
    ("i2", $mode_selector.i2),
    ("phet", $mode_selector.phet),
    ("dof", $mode_selector.dof),
    ("snpr2", $mode_selector.snpr2),
    ("f", $mode_selector.f),
    ("other", $mode_selector.other)
]
#if str($value)
--$flag '$value'
#end if
#end for
#elif str($mode_selector.load_mode) == "format"
--input '$mode_selector.input'
--format-name '$mode_selector.format_name'
--sep '$shared.sep'
--skiprows '$shared.skiprows'
#if str($shared.nrows)
--nrows '$shared.nrows'
#end if
#if str($shared.na_values)
--na-values '$shared.na_values'
#end if
#if str($shared.build) != "unset"
--build '$shared.build'
#end if
#if $shared.verbose
--verbose
#end if
#elif str($mode_selector.load_mode) == "auto"
--input '$mode_selector.input'
--sep '$shared.sep'
--skiprows '$shared.skiprows'
#if str($shared.nrows)
--nrows '$shared.nrows'
#end if
#if str($shared.na_values)
--na-values '$shared.na_values'
#end if
#if str($shared.build) != "unset"
--build '$shared.build'
#end if
#if $shared.verbose
--verbose
#end if
#elif str($mode_selector.load_mode) == "chromsplit"
--chrom-manifest 'chrom_manifest.tsv'
--chrom-format-mode '$mode_selector.chrom_format_mode'
--sep '$shared.sep'
--skiprows '$shared.skiprows'
#if str($shared.nrows)
--nrows '$shared.nrows'
#end if
#if str($shared.na_values)
--na-values '$shared.na_values'
#end if
#if str($shared.build) != "unset"
--build '$shared.build'
#end if
#if $shared.verbose
--verbose
#end if
#if str($mode_selector.chrom_format_mode) == "format"
--format-name '$mode_selector.format_name'
#elif str($mode_selector.chrom_format_mode) == "columns"
#for $flag, $value in [
    ("snpid", $mode_selector.snpid),
    ("rsid", $mode_selector.rsid),
    ("chrom", $mode_selector.chrom),
    ("pos", $mode_selector.pos),
    ("ea", $mode_selector.ea),
    ("nea", $mode_selector.nea),
    ("ref", $mode_selector.ref),
    ("alt", $mode_selector.alt),
    ("eaf", $mode_selector.eaf),
    ("neaf", $mode_selector.neaf),
    ("n", $mode_selector.n),
    ("beta", $mode_selector.beta),
    ("se", $mode_selector.se),
    ("chisq", $mode_selector.chisq),
    ("z", $mode_selector.z),
    ("p", $mode_selector.p),
    ("mlog10p", $mode_selector.mlog10p),
    ("info", $mode_selector.info),
    ("direction", $mode_selector.direction),
    ("ncontrol", $mode_selector.ncontrol),
    ("ncase", $mode_selector.ncase),
    ("maf", $mode_selector.maf),
    ("status", $mode_selector.status),
    ("or-column", $mode_selector.or_column),
    ("or-95l", $mode_selector.or_95l),
    ("or-95u", $mode_selector.or_95u),
    ("hr-column", $mode_selector.hr_column),
    ("hr-95l", $mode_selector.hr_95l),
    ("hr-95u", $mode_selector.hr_95u),
    ("beta-95l", $mode_selector.beta_95l),
    ("beta-95u", $mode_selector.beta_95u),
    ("i2", $mode_selector.i2),
    ("phet", $mode_selector.phet),
    ("dof", $mode_selector.dof),
    ("snpr2", $mode_selector.snpr2),
    ("f", $mode_selector.f),
    ("other", $mode_selector.other)
]
#if str($value)
--$flag '$value'
#end if
#end for
#end if
#end if
--output-tsv '$output_tsv'
--output-meta '$output_meta'
--log '$log'
]]></command>
